      "source": [
        "import numpy as np\n",
        "import math\n",
        "\n",
        "# Conic: 3x² + 2xy + 3y² - 4 = 0\n",
        "A = 3\n",
        "B = 2\n",
        "C = 3\n",
        "\n",
        "# Quadratic form matrix\n",
        "Q = np.array([\n",
        "    [A, B/2],\n",
        "    [B/2, C]\n",
        "])\n",
        "\n",
        "# Eigenvalues and eigenvectors\n",
        "eigenvalues, eigenvectors = np.linalg.eigh(Q)\n",
        "\n",
        "# Rotation angle\n",
        "angle = math.degrees(\n",
        "    math.atan2(eigenvectors[1, 1], eigenvectors[0, 1])\n",
        ")\n",
        "\n",
        "print(\"Quadratic Form Matrix:\")\n",
        "print(Q)\n",
        "\n",
        "print(\"\\nEigenvalues:\")\n",
        "print(eigenvalues)\n",
        "\n",
        "print(\"\\nRotation Angle:\")\n",
        "print(f\"{angle:.2f} degrees\")"
      ],
