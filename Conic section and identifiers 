    {
      "cell_type": "code",
      "source": [
        "det_Q = np.linalg.det(Q)\n",
        "\n",
        "if det_Q > 0:\n",
        "    if A * C > 0:\n",
        "        conic_type = \"Ellipse\"\n",
        "    else:\n",
        "        conic_type = \"Imaginary/degenerate case\"\n",
        "elif det_Q < 0:\n",
        "    conic_type = \"Hyperbola\"\n",
        "else:\n",
        "    conic_type = \"Parabola\"\n",
        "\n",
        "print(\"Conic Type:\", conic_type)"
