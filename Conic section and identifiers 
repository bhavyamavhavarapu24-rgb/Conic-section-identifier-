        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Conic coefficients\n",
        "A = 3\n",
        "B = 2\n",
        "C = 3\n",
        "D = 0\n",
        "E = 0\n",
        "F = -4\n",
        "\n",
        "# Create coordinate grid\n",
        "x = np.linspace(-3, 3, 400)\n",
        "y = np.linspace(-3, 3, 400)\n",
        "X, Y = np.meshgrid(x, y)\n",
        "\n",
        "# Conic equation\n",
        "Z = A*X**2 + B*X*Y + C*Y**2 + D*X + E*Y + F\n",
        "\n",
        "# Plot\n",
        "plt.figure(figsize=(7, 7))\n",
        "plt.contour(X, Y, Z, levels=[0])\n",
        "\n",
        "plt.axhline(0)\n",
        "plt.axvline(0)\n",
        "\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"y\")\n",
        "plt.title(\"Conic Section: Ellipse\")\n",
        "\n",
        "plt.grid()\n",
        "plt.axis(\"equal\")\n",
        "plt.show()"
